  "random": 7,
  "hold": true,
  "steps": [
   [
    "waitReal",
    "window.__launched === true",
    180000
   ],
   [
    "until",
    "window.__GLEAMTRAIL__.game.scene.isActive('BoardUI')",
    60
   ],
   [
    "skip",
    0.2
   ],
   [
    "eval",
    "(() => { const G = window.__GLEAMTRAIL__; const m = G.session.match; const r = [5, 4, 3, 2], c = [12, 30, 25, 18]; m.players.forEach((p, i) => { p.relics = r[i]; p.chips = c[i]; }); const sm = G.game.scene; sm.stop('BoardUI'); sm.stop('BoardBg'); sm.stop('Board'); sm.start('FinalResults', { state: m, awards: [] }); })()"
   ],
   [
    "until",
    "window.__GLEAMTRAIL__.game.scene.isActive('FinalResults')",
    30
   ],
   [
    "mark",
    "start"
   ],
   [
    "watch",
    "window.__texts(40)"
   ],
   [
    "skip",
    10.4
   ],
   [
    "record",
    17.6
   ]
  ]
 },
